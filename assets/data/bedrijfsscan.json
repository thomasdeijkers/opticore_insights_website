{
  "steps": [
    {
      "title": "Je bedrijf",
      "intro": "Kies wat bij jouw bedrijf past. Je naam en contactgegevens vragen we pas bij het versturen.",
      "fields": [
        {
          "key": "sector",
          "label": "Wat doet je bedrijf?",
          "type": "select",
          "required": true,
          "ai": true,
          "options": [
            "Webshop en e-commerce",
            "Groothandel en handel",
            "Bouw en installatie",
            "Zakelijke dienstverlening",
            "Productie en techniek",
            "Retail en winkels",
            "Zorg en welzijn",
            "Een andere sector"
          ]
        },
        {
          "key": "team",
          "label": "Met hoeveel mensen werken jullie?",
          "type": "select",
          "required": true,
          "options": [
            "Alleen ik",
            "2–5 mensen",
            "6–15 mensen",
            "16–50 mensen",
            "Meer dan 50 mensen"
          ],
          "ai": true
        },
        {
          "key": "revenue",
          "label": "Wat is ongeveer de jaaromzet?",
          "type": "select",
          "options": [
            "Minder dan €250.000",
            "€250.000–€1 miljoen",
            "€1–5 miljoen",
            "€5–25 miljoen",
            "Meer dan €25 miljoen",
            "Liever niet delen"
          ],
          "ai": true
        }
      ]
    },
    {
      "title": "Het dagelijkse werk",
      "intro": "Kruis aan waar het werk nu vastloopt. Bij de aankruisvragen kun je meerdere antwoorden kiezen.",
      "fields": [
        {
          "key": "areas",
          "label": "Welke processen vragen aandacht?",
          "type": "checkboxes",
          "required": true,
          "options": [
            "Verkoop en klantaanvragen",
            "Orders en administratie",
            "Inkoop en voorraad",
            "Planning en uitvoering",
            "Financiën en rapportages",
            "Productgegevens en webshop",
            "Documenten en controles",
            "Samenwerking en overdracht"
          ],
          "ai": true
        },
        {
          "key": "pain",
          "label": "Welk terugkerend werk kost onnodig moeite?",
          "type": "checkboxes",
          "required": true,
          "ai": true,
          "options": [
            "Gegevens overtypen of kopiëren",
            "Cijfers en rapportages verzamelen",
            "Orders of documenten verwerken",
            "Voorraad controleren en bestellen",
            "Planning en taken bijhouden",
            "Klanten en aanvragen opvolgen",
            "Gegevens controleren en fouten herstellen"
          ]
        },
        {
          "key": "frequency",
          "label": "Hoe vaak komt dit voor?",
          "type": "select",
          "required": true,
          "options": [
            "Meerdere keren per dag",
            "Dagelijks",
            "Wekelijks",
            "Maandelijks",
            "Wisselend / per project"
          ],
          "ai": true
        },
        {
          "key": "hours",
          "label": "Hoeveel tijd kost dit in totaal per week voor het hele team?",
          "type": "select",
          "options": [
            "Minder dan 2 uur per week",
            "2–5 uur per week",
            "5–10 uur per week",
            "10–20 uur per week",
            "Meer dan 20 uur per week",
            "Dat weet ik nog niet"
          ],
          "ai": true
        },
        {
          "key": "impact",
          "label": "Wat merk je ervan?",
          "type": "checkboxes",
          "options": [
            "Dubbel werk of overtypen",
            "Fouten en herstelwerk",
            "Wachten of gemiste afspraken",
            "Onduidelijk wie iets oppakt",
            "Geen actueel overzicht",
            "Besluiten op gevoel",
            "Klanten moeten navragen",
            "Werk blijft bij één persoon hangen"
          ],
          "ai": true
        }
      ]
    },
    {
      "title": "Systemen en inzicht",
      "intro": "Kies de hulpmiddelen die je gebruikt, het inzicht dat je mist en wat je ermee wilt kunnen doen.",
      "fields": [
        {
          "key": "systems",
          "label": "Welke systemen, apps of bestanden gebruiken jullie?",
          "type": "checkboxes",
          "required": true,
          "ai": true,
          "options": [
            "Excel of andere spreadsheets",
            "Boekhoudpakket (zoals Exact of Moneybird)",
            "Webshop of marketplace",
            "ERP of voorraadsoftware",
            "CRM of klantbeheer",
            "Planning of projectsoftware",
            "E-mail en losse documenten",
            "Papieren formulieren",
            "Een ander systeem"
          ]
        },
        {
          "key": "transfer",
          "label": "Hoe gaat informatie van de ene stap naar de volgende?",
          "type": "select",
          "required": true,
          "options": [
            "Vooral handmatig kopiëren of overtypen",
            "Via e-mail en losse bestanden",
            "Gedeeltelijk gekoppeld",
            "Grotendeels automatisch",
            "Dat weet ik niet precies"
          ],
          "ai": true
        },
        {
          "key": "missing",
          "label": "Welk inzicht mis je om goed te kunnen sturen?",
          "type": "checkboxes",
          "ai": true,
          "options": [
            "Omzet en marge",
            "Voorraad en bestelbehoefte",
            "Planning en beschikbare capaciteit",
            "Openstaande orders en acties",
            "Projectkosten en voortgang",
            "Marketingresultaten en conversie"
          ]
        },
        {
          "key": "action",
          "label": "Wat wil je vanuit een overzicht kunnen doen?",
          "type": "checkboxes",
          "ai": true,
          "options": [
            "Een bestelling voorbereiden",
            "Werk of taken toewijzen",
            "Een klant of aanvraag opvolgen",
            "Afwijkingen beoordelen en oplossen",
            "Producten of campagnes bijsturen",
            "Documenten goedkeuren en doorzetten"
          ]
        }
      ]
    },
    {
      "title": "Doel en prioriteit",
      "intro": "Kies wat je wilt bereiken. Op de volgende pagina verschijnt automatisch jouw samenvatting.",
      "fields": [
        {
          "key": "goal",
          "label": "Wat moet een verbetering opleveren?",
          "type": "checkboxes",
          "required": true,
          "ai": true,
          "options": [
            "Minder handmatig werk",
            "Minder fouten en herstelwerk",
            "Actuele cijfers op één plek",
            "Sneller actie kunnen nemen",
            "Duidelijke taken en overdracht",
            "Groei beter kunnen opvangen"
          ]
        },
        {
          "key": "priority",
          "label": "Wat weegt voor jou het zwaarst?",
          "type": "select",
          "required": true,
          "options": [
            "Minder handwerk en tijdverlies",
            "Minder fouten en betrouwbaardere gegevens",
            "Meer grip en sneller besluiten",
            "Betere planning en samenwerking",
            "Groei opvangen zonder extra administratie",
            "Betere klantervaring"
          ],
          "ai": true
        },
        {
          "key": "timing",
          "label": "Wanneer wil je hiermee aan de slag?",
          "type": "select",
          "options": [
            "Zo snel mogelijk",
            "Binnen 1–3 maanden",
            "Binnen 3–6 maanden",
            "Ik ben me aan het oriënteren"
          ],
          "ai": true
        },
        {
          "key": "constraints",
          "label": "Wil je nog iets toelichten?",
          "type": "textarea",
          "max": 1000,
          "placeholder": "Bijvoorbeeld de naam van je software, een ander knelpunt of een wens die niet tussen de keuzes staat. Je mag dit leeg laten.",
          "ai": true
        }
      ]
    }
  ]
}
