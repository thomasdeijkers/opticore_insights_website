/assets/img/module-examples/client-beeldstudio-*-dark.jpg

# New native picklist captures are generated and cached during deployment.
/assets/img/module-examples/client-orders-pickrestanten-*-dark.jpg
/assets/img/module-examples/client-orders-pickbevestiging-*-dark.jpg

